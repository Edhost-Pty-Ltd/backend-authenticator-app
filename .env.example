NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://auth_admin:password@localhost:5432/multi_auth
# Exactly 64 hexadecimal characters (32 bytes). Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=replace_with_64_hex_characters
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=multiauth
JWT_AUDIENCE=multiauth-client
JWT_SERVICE_AUDIENCE=multiauth-service
# Required in production. Protects application registration and management endpoints.
ADMIN_API_KEY=replace_with_a_long_random_admin_key
# Required in production because /internal is always enabled.
MYANGANO_SERVICE_API_KEY=replace_with_a_long_random_service_key
MYANGANO_WEBHOOK_URL=http://localhost:5000/internal/webhooks/2fa-status
# Comma-separated exact browser origins. Leave empty if no browser frontend needs CORS.
CORS_ORIGINS=http://localhost:3000
# Set true only when the app is behind a single trusted reverse proxy.
TRUST_PROXY=false
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
